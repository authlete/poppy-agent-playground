# Company website host — discovery root (/.well-known/poppy.json).
POPPY_COMPANY=stays.127.0.0.1.nip.io

# Agent identity (CIMD). Default: self-host it at {POPPY_PUBLIC_URL}/client-metadata.json.
POPPY_PUBLIC_URL=
# ...or bring your own CIMD URL instead of self-hosting:
POPPY_CLIENT_ID=

# Agent ES256 signing key — provide ONE of:
#   POPPY_AGENT_KEY       inline JWK JSON (prod/Vercel)
#   POPPY_AGENT_KEY_PATH  path to a JWK file (local dev)
POPPY_AGENT_KEY=
POPPY_AGENT_KEY_PATH=

# Direct Sign-In redirect. Defaults to {request origin}/callback; must be registered on the CIMD.
POPPY_REDIRECT_URI=

# --- Local dev only (leave unset in production) ---
# Allow loopback/private Company hosts.
POPPY_ALLOW_PRIVATE=true
# Request Bearer tokens for a resource server that only validates Bearer.
POPPY_DISABLE_DPOP=true
# Trust the self-signed mkcert certs (localhost + Company host).
NODE_TLS_REJECT_UNAUTHORIZED=0
