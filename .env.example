# All optional. A deployed instance needs none of these.

# Prefill the Company field (typed in the UI otherwise).
POPPY_DEFAULT_COMPANY=

# This app's public URL, where the AS fetches its self-hosted CIMD. Auto-detected on Vercel.
POPPY_AGENT_URL=

# Bring your own CIMD + its ES256 key, instead of self-hosting (which generates a key).
POPPY_CLIENT_ID=
POPPY_AGENT_KEY=

# Override the sign-in redirect (default {origin}/callback).
POPPY_REDIRECT_URI=

# Local dev only.
POPPY_ALLOW_PRIVATE=
NODE_TLS_REJECT_UNAUTHORIZED=
